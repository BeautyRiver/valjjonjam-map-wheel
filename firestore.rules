rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 멤버 정보 컬렉션.
    // - 웹(팀짜기 탭)은 users를 "읽기"만 함 → 읽기 허용
    // - 저장/수정/삭제는 디스코드 봇만 수행하는데,
    //   봇은 Admin SDK(serviceAccountKey.json)로 접속해서 이 규칙을 무시함
    //   → 클라이언트 쓰기는 전부 차단해도 봇 동작에는 영향 없음
    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // 그 외 모든 경로는 클라이언트 접근 전면 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
